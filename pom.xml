    <artifactId>connected-components</artifactId>
    <version>5.0.0-a.5</version>

    <name>ConnectedComponents</name>
    <description>
        This plugin extracts groups of connected pixels in 2D and 3D based on their intensity and that of the background.
        Works on both binary and gray-scale data.
        Output can be pushed to the swimming pool for other plug-ins to further exploit the extracted objects.
    </description>
    <url>https://icy.bioimageanalysis.org/</url>
    <inceptionYear>2011</inceptionYear>

    <scm>
        <url>https://gitlab.pasteur.fr/bia/icy/extensions/connected-components</url>
        <tag>v${project.version}</tag>
    </scm>

